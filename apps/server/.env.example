# Desarrollo local (SQLite, sin configuración adicional):
# connection_limit=1 fuerza a Prisma a serializar TODAS las consultas por una
# sola conexión — probado sin este límite (dejando el default de Prisma) y
# generó más fallas bajo ráfagas concurrentes, no menos: varias conexiones
# compitiendo por el único escritor de SQLite se pisan entre sí. Con
# connection_limit=1 no compiten, solo hacen cola. pool_timeout=30 le da
# hasta 30s a una consulta en cola antes de fallar (el default de 10s se
# quedaba corto). El código además reintenta automáticamente las escrituras
# que igual choquen con esto (ver `conReintento` en `modules/pedidos/service.ts`).
# Es más lento bajo carga muy alta, pero no falla — el camino real a más
# throughput es migrar a Postgres (ver sección 13 de ARCHITECTURE.md), no
# aflojar esto.
DATABASE_URL="file:./dev.db?connection_limit=1&pool_timeout=30"

# Producción (descomentar y usar Neon/Supabase/Railway, y cambiar el
# provider en prisma/schema.prisma a "postgresql"):
# DATABASE_URL="postgresql://usuario:password@host:5432/churrasco"

JWT_SECRET="cambia-este-secreto-en-produccion"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
