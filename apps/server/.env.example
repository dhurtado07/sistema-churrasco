# Desarrollo local: Postgres corriendo en Docker (ver docker-compose.yml en
# la raíz del repo — "pnpm db:up" antes de esto). El puerto 5433 (no el
# 5432 de siempre) evita chocar con un Postgres nativo que ya tengas
# instalado en tu máquina.
DATABASE_URL="postgresql://postgres:devpassword@localhost:5433/churrasco"

# Nota (Windows + Podman en vez de Docker Desktop): si "localhost" da error
# de autenticación pese a que la contraseña es correcta, es un problema de
# reenvío de puertos de la VM de Podman en Windows — usar la IP de la VM
# (`podman machine ssh "ip addr show eth0"`) en vez de localhost.

JWT_SECRET="cambia-este-secreto-en-produccion"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Producción: ver .env.prod.example en la raíz del repo — ese es el que se
# usa de verdad en el VPS (con docker-compose.prod.yml), no este archivo.
