# URL del servidor (mismo backend que usan caja/cocina/parrilla)
API_URL="http://localhost:4000"

# Cuenta dedicada del agente de impresión (rol "impresora", creada por el seed).
PRINT_AGENT_USERNAME="impresora"
PRINT_AGENT_PASSWORD="impresora123"

# "file"  -> modo de prueba: escribe cada ticket en TICKETS_DIR, sin impresora física.
# "usb"   -> impresora térmica conectada por USB (ej. Epson TM-T20IV-L). Manda los bytes
#            ESC/POS crudos a la cola de impresión del sistema. Configurar PRINTER_NAME abajo.
# "tcp"   -> impresora térmica real por red/LAN, protocolo ESC/POS crudo (puerto 9100 estándar).
#            Configurar PRINTER_HOST/PRINTER_PORT abajo.
PRINTER_SINK="usb"

# Solo para PRINTER_SINK=usb — nombre de la impresora en el sistema:
#  - macOS/Linux: nombre de la cola CUPS. Verlo con:  lpstat -p
#  - Windows: nombre del RECURSO COMPARTIDO de la impresora (Propiedades de impresora ->
#    Compartir -> marcar "Compartir esta impresora" y poner un nombre corto sin espacios).
PRINTER_NAME="TM-T20IV-L"

# Solo para PRINTER_SINK=tcp:
PRINTER_HOST="192.168.1.50"
PRINTER_PORT=9100

TICKETS_DIR="./tickets"
