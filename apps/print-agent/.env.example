# URL del servidor (mismo backend que usan caja/cocina/parrilla)
API_URL="http://localhost:4000"

# Cuenta dedicada del agente de impresión (rol "impresora", creada por el seed).
PRINT_AGENT_USERNAME="impresora"
PRINT_AGENT_PASSWORD="impresora123"

# "file"  -> modo de prueba: escribe cada ticket en TICKETS_DIR, sin impresora física.
# "tcp"   -> impresora térmica real por red/LAN, protocolo ESC/POS crudo (puerto 9100 estándar,
#            el mismo que usan la mayoría de impresoras térmicas con Ethernet/WiFi o un
#            adaptador USB-a-red). Configurar PRINTER_HOST/PRINTER_PORT abajo.
PRINTER_SINK="file"

PRINTER_HOST="192.168.1.50"
PRINTER_PORT=9100

TICKETS_DIR="./tickets"
