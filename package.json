{
  "name": "sistema-churrasco",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web dev",
    "dev:print-agent": "pnpm --filter print-agent dev",
    "build": "pnpm --filter shared build && pnpm --filter server build && pnpm --filter web build && pnpm --filter print-agent build",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:seed": "pnpm --filter server db:seed",
    "db:studio": "pnpm --filter server db:studio"
  }
}
