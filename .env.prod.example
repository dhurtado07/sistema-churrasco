# Variables de entorno de PRODUCCIÓN — este archivo es solo referencia.
# El real (.env.prod) vive ÚNICAMENTE en el VPS, en la misma carpeta que
# docker-compose.prod.yml, y NUNCA se sube a git.
#
# Generar valores nuevos y fuertes para POSTGRES_PASSWORD y JWT_SECRET, por
# ejemplo con: openssl rand -base64 32

POSTGRES_PASSWORD="cambiar-por-una-contraseña-larga-y-aleatoria"
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Dominios reales del negocio — deben apuntar (registro DNS tipo A) a la IP
# de este VPS para que Caddy pueda sacar el certificado HTTPS automático.
CORS_ORIGIN="https://brasaarisp.com,https://www.brasaarisp.com"
VITE_API_URL="https://api.brasaarisp.com"
